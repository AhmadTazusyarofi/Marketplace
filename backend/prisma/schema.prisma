generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AppRole {
  buyer
  seller
  admin
}

model User {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  email            String    @unique(map: "uq_users_email") @db.VarChar(191)
  passwordHash     String    @map("password_hash") @db.VarChar(255)
  fullName         String    @map("full_name") @db.VarChar(191)
  phone            String?   @db.VarChar(50)
  avatarUrl        String?   @map("avatar_url") @db.Text
  role             AppRole   @default(buyer)
  defaultAddressId BigInt?   @map("default_address_id") @db.UnsignedBigInt
  createdAt        DateTime? @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime? @default(now()) @map("updated_at") @db.DateTime(0)

  stores         Store[]
  carts          Cart[]
  orders         Order[]
  addresses      UserAddress[] @relation("UserAddresses")
  defaultAddress UserAddress?  @relation("UserDefaultAddress", fields: [defaultAddressId], references: [id], onDelete: SetNull)

  @@index([defaultAddressId], map: "idx_users_default_address")
  @@map("users")
}

model UserAddress {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId        BigInt    @map("user_id") @db.UnsignedBigInt
  label         String    @default("Rumah") @db.VarChar(50)
  recipientName String    @map("recipient_name") @db.VarChar(191)
  phone         String    @db.VarChar(50)
  addressLine   String    @map("address_line") @db.Text
  postalCode    String?   @map("postal_code") @db.VarChar(20)
  note          String?   @db.Text
  createdAt     DateTime? @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt     DateTime? @default(now()) @map("updated_at") @db.DateTime(0)
  deletedAt     DateTime? @map("deleted_at") @db.DateTime(0)

  user            User   @relation("UserAddresses", fields: [userId], references: [id], onDelete: Cascade)
  defaultForUsers User[] @relation("UserDefaultAddress")

  @@index([userId], map: "idx_user_addresses_user")
  @@index([deletedAt], map: "idx_user_addresses_deleted")
  @@map("user_addresses")
}

model Store {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  ownerId     BigInt    @unique(map: "uq_stores_owner") @map("owner_id") @db.UnsignedBigInt
  name        String    @db.VarChar(191)
  description String?   @db.Text
  logoUrl     String?   @map("logo_url") @db.Text
  location    String?   @db.VarChar(191)
  isActive    Boolean?  @default(true) @map("is_active")
  createdAt   DateTime? @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt   DateTime? @default(now()) @map("updated_at") @db.DateTime(0)

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  products Product[]

  orderItems OrderItem[]

  @@index([ownerId], map: "idx_stores_owner")
  @@map("stores")
}

model Category {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name      String    @db.VarChar(100)
  slug      String    @unique(map: "slug") @db.VarChar(120)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @default(now()) @map("updated_at") @db.Timestamp(0)

  products Product[]

  @@map("categories")
}

model Product {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  storeId       BigInt    @map("store_id") @db.UnsignedBigInt
  categoryId    BigInt?   @map("category_id") @db.UnsignedBigInt
  name          String    @db.VarChar(191)
  description   String?   @db.Text
  price         Decimal   @db.Decimal(12, 2)
  originalPrice Decimal?  @map("original_price") @db.Decimal(12, 2)
  stock         Int?      @default(0)
  isActive      Boolean?  @default(true) @map("is_active")
  soldCount     Int?      @default(0) @map("sold_count")
  viewCount     Int?      @default(0) @map("view_count")
  createdAt     DateTime? @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt     DateTime? @default(now()) @map("updated_at") @db.DateTime(0)
  deletedAt     DateTime? @map("deleted_at") @db.DateTime(0)

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])

  images         ProductImage[]
  variants       ProductVariant[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  flashSaleItems FlashSaleItem[]

  @@index([storeId], map: "idx_products_store")
  @@index([categoryId], map: "idx_products_category")
  @@index([deletedAt], map: "idx_products_deleted")
  @@map("products")
}

model Cart {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt    @unique(map: "uq_carts_user") @map("user_id") @db.UnsignedBigInt
  createdAt DateTime? @default(now()) @map("created_at") @db.DateTime(0)

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  cartId    BigInt   @map("cart_id") @db.UnsignedBigInt
  productId BigInt   @map("product_id") @db.UnsignedBigInt
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId], map: "uq_cart_product")
  @@index([cartId], map: "idx_cart_items_cart")
  @@index([productId], map: "idx_cart_items_product")
  @@map("cart_items")
}

model Order {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  buyerId         BigInt    @map("buyer_id") @db.UnsignedBigInt
  totalAmount     Decimal   @map("total_amount") @db.Decimal(12, 2)
  status          String?   @default("pending") @db.VarChar(50)
  shippingAddress String    @map("shipping_address") @db.Text
  shippingPhone   String    @map("shipping_phone") @db.VarChar(50)
  notes           String?   @db.Text
  createdAt       DateTime? @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt       DateTime? @default(now()) @map("updated_at") @db.DateTime(0)

  buyer    User        @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  items    OrderItem[]
  payments Payment[]

  @@index([buyerId], map: "idx_orders_buyer")
  @@map("orders")
}

model OrderItem {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  orderId   BigInt   @map("order_id") @db.UnsignedBigInt
  productId BigInt   @map("product_id") @db.UnsignedBigInt
  storeId   BigInt   @map("store_id") @db.UnsignedBigInt
  quantity  Int
  price     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([orderId], map: "idx_order_items_order")
  @@index([productId], map: "idx_order_items_product")
  @@index([storeId], map: "idx_order_items_store")
  @@map("order_items")
}

model Payment {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  orderId          BigInt    @map("order_id") @db.UnsignedBigInt
  paymentMethod    String    @map("payment_method") @db.VarChar(50)
  paymentStatus    String?   @default("pending") @map("payment_status") @db.VarChar(50)
  paymentReference String?   @map("payment_reference") @db.VarChar(191)
  paidAt           DateTime? @map("paid_at") @db.DateTime(0)
  createdAt        DateTime? @default(now()) @map("created_at") @db.DateTime(0)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId], map: "idx_payments_order")
  @@map("payments")
}

model ProductImage {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  productId BigInt   @map("product_id") @db.UnsignedBigInt
  imagePath String   @map("image_path") @db.VarChar(255)
  isPrimary Boolean? @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId], map: "fk_product_images_product")
  @@map("product_images")
}

model ProductVariant {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  productId     BigInt   @map("product_id") @db.UnsignedBigInt
  variantType   String   @map("variant_type") @db.VarChar(50)
  variantValue  String   @map("variant_value") @db.VarChar(100)
  stock         Int      @default(0)
  priceModifier Decimal  @default(0) @map("price_modifier") @db.Decimal(12, 2)
  sku           String?  @db.VarChar(100)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId], map: "idx_product_variants_product")
  @@map("product_variants")
}

model FlashSale {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  title     String   @db.VarChar(191)
  startTime DateTime @map("start_time") @db.DateTime(0)
  endTime   DateTime @map("end_time") @db.DateTime(0)
  isActive  Boolean? @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)

  items FlashSaleItem[]

  @@index([startTime, endTime], map: "idx_flash_sales_time")
  @@map("flash_sales")
}

model FlashSaleItem {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  flashSaleId BigInt    @map("flash_sale_id") @db.UnsignedBigInt
  productId   BigInt    @map("product_id") @db.UnsignedBigInt
  flashPrice  Decimal   @map("flash_price") @db.Decimal(12, 2)
  quota       Int
  sold        Int?      @default(0)
  createdAt   DateTime? @default(now()) @map("created_at") @db.DateTime(0)

  flashSale FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([flashSaleId, productId], map: "uq_flash_product")
  @@index([flashSaleId], map: "idx_flash_sale_id")
  @@index([productId], map: "idx_flash_product_id")
  @@map("flash_sale_items")
}
